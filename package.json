{
  "name": "growlink-crop-steering",
  "private": true,
  "version": "0.1.0",
  "description": "Crop Steering Autopilot \u2014 Grodan 5-Phase irrigation steering with AI, built on the Growlink Developer API",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test -w @gl-steering/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "sim": "npm run sim -w @gl-steering/core --",
    "db:migrate": "npm run migrate -w @gl-steering/controller",
    "dev:controller": "npm run dev -w @gl-steering/controller",
    "dev:web": "npm run dev -w @gl-steering/web",
    "build:web": "npm run build -w @gl-steering/web"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
