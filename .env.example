# ── Shared by web + controller ─────────────────────────────
# Postgres connection (Supabase: Settings → Database → Session pooler URI)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/steering
# 32 random bytes, base64 — encrypts tenant API keys. `openssl rand -base64 32`
VAULT_MASTER_KEY=

# ── Web (apps/web) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local only: skip Supabase Auth and sign in as a fixed demo user
DEV_AUTH_BYPASS=0

# ── Controller (apps/controller) ──────────────────────────
# Nova (controller only — never set these on Vercel)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AI_PROVIDER=openai          # blank = OpenAI if its key is set, else Anthropic
# AI_MODEL=gpt-6.1-sol        # blank = provider default
TICK_MS=30000
WATCHDOG_MS=2000
HARD_MAX_SHOT_SECONDS=900
# Override only for a Growlink staging API
GROWLINK_BASE_URL=
